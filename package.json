{
  "name": "recharge-map",
  "version": "1.0.0",
  "description": "Carte des bornes de recharge par type de prise, avec tarifs et disponibilité : agrège Open Charge Map, OpenStreetMap et la base IRVE",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
