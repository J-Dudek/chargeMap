# À copier en .env (jamais commité), puis à remplir.
# Docker compose le lit tout seul ; en local : node --env-file=.env server/index.js

# Clé gratuite Open Charge Map : https://openchargemap.org/site/develop/api
OCM_API_KEY=

# true quand un reverse proxy HTTPS est devant l'app (le cas sur le NAS), false seulement en accès direct.
TRUST_PROXY=true

# Fond de carte, facultatif : OpenFreeMap par défaut, sans clé. Voir « Fonds de carte » dans le README.
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Ou des tuiles image d'un autre fournisseur, qui remplacent alors OpenFreeMap :
# TILE_URL=https://…/{z}/{x}/{y}.png?access-token=VOTRE_CLE
# TILE_ATTRIBUTION=© Fournisseur, © contributeurs OpenStreetMap

# Adresse publique du site, en https, sans / final. À remplir en production : elle sert pour l'URL
# canonique, le sitemap et les aperçus de partage, et active l'en-tête HSTS.
# SITE_URL=https://recharge.byj6n.fr
